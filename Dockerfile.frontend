# Base images are pinned by exact version and digest: a rebuild of the same
# commit uses the same base. Bump both (tag and digest) on purpose.
FROM node:22.23.2-alpine3.24@sha256:b6f26b36c8ff49624cfdac716b8ea1138d606df02586a77d364bb5536a634f85 AS builder

WORKDIR /app

# .npmrc too, so the install uses the same npm settings as CI's `npm ci`.
COPY package.json package-lock.json .npmrc ./
RUN npm ci

COPY public ./public
COPY src ./src
COPY tsconfig.json ./

ENV CI=false
ENV REACT_APP_API_BASE_URL=/api
ENV REACT_APP_TMDB_BASE_URL=/api/tmdb
ENV REACT_APP_MEDIA_BASE_URL=
# Emit the webpack runtime as a file, so nginx's CSP needs no inline script.
ENV INLINE_RUNTIME_CHUNK=false

RUN npm run build

FROM nginx:1.31.5-alpine3.24@sha256:72ba65eb42c10344912a84ff42408db7d34f2feb642204570ab8fc5ffd29f1d3

COPY --from=builder /app/build /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
