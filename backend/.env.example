# Required when DEBUG is off (the built-in development default is refused).
SECRET_KEY=your-secret-key-here-change-in-production
# Optional: a separate key for signing JWTs. Defaults to SECRET_KEY.
# JWT_SIGNING_KEY=another-long-random-key
TMDB_API_KEY=your_tmdb_api_key_here
# Optional: TMDB API host. Defaults to api.tmdb.org (official alternate host,
# fewer TLS resets on some networks than api.themoviedb.org).
# TMDB_API_HOST=api.tmdb.org
DB_NAME=cinedb
DB_USER=postgres
DB_PASSWORD=your-password
DB_HOST=localhost
DB_PORT=5432
# Docker only: the password lives in .env.db (see .env.db.example), never in
# .env.docker; the backend falls back to it when DB_PASSWORD is unset:
# POSTGRES_PASSWORD=   <- in .env.db, not here
# Seconds a DB connection is kept for reuse with DEBUG off (default 60). Under
# DEBUG it's always 0: runserver's per-request threads never reuse one.
# CONN_MAX_AGE=60

# DEBUG defaults to OFF when unset (fail closed). `npm run dev` (start.py) and
# the pytest suite turn it on themselves; set it here only if you run
# `manage.py runserver`/other commands by hand for local development.
# DEBUG=True

# Required when DEBUG is off: comma-separated real hostnames. Empty or `*` is
# refused at startup. For Docker (.env.docker) include `localhost` — the
# compose healthcheck calls localhost:8000 — plus every name/IP browsers use
# (e.g. your LAN IP, since nginx forwards the browser's Host header).
# ALLOWED_HOSTS=localhost,cinedb.example.com

# Number of reverse proxies in front of Django, used to find the real client
# address for rate limiting. 0 (default) = no proxy, ignore X-Forwarded-For.
# docker-compose.yml already sets 1 for the nginx front end.
# TRUSTED_PROXY_COUNT=0

# Read only when DEBUG is off (DEBUG allows every origin). Comma-separated
# origins allowed to call the API from a browser on another origin. Leave it
# unset for the bundled Docker stack: nginx serves the app and the API on one
# origin, so no cross-origin call happens.
# CORS_ALLOWED_ORIGINS=https://app.example.com

# Required when DEBUG is off (startup fails without it, so live password-reset
# links are never silently printed to the log). Dev defaults to the console
# backend. Set it to the console backend explicitly if a deploy sends no mail.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=you@gmail.com
# EMAIL_HOST_PASSWORD=your_app_password
# Sender address; defaults to EMAIL_HOST_USER, else noreply@cinedb.app.
# DEFAULT_FROM_EMAIL=CINE DB <you@gmail.com>
# Seconds before an SMTP connect or send gives up (default 10).
# EMAIL_TIMEOUT=10

# Required when DEBUG is off: the app's public address, the base of
# password-reset links (absolute http(s) URL; a trailing slash is dropped).
# DEBUG defaults it to the dev server, http://localhost:3000.
# FRONTEND_URL=https://cinedb.example.com
