__pycache__
*.pyc
*.pyo
*.pyd
# Every env file except the committed templates, including stray copies
# (.env.local, .env.docker.bak, ...): none of them may end up in an image.
.env
.env.*
!.env.example
!.env.db.example
*.env.bak
db.sqlite3
**/__pycache__/
.pytest_cache/
# Uploaded files belong in the media_data volume, never in an image.
media/
staticfiles/
# Tests and dev-only startup files never run in the image (the entrypoint
# runs manage.py and gunicorn directly).
userdata/tests/
conftest.py
pytest.ini
pytest_dev_env.py
requirements-test.txt
start.py
.ruff_cache/
