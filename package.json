  "scripts": {
    "prestart": "kill-port 3000 8000",
    "start": "concurrently \"react-scripts start\" \"G:/Anaconda/envs/django/python.exe backend/start.py\"",
    "django": "G:/Anaconda/envs/django/python.exe backend/start.py",
    "predev": "kill-port 3000 8000",
    "dev": "concurrently \"react-scripts start\" \"G:/Anaconda/envs/django/python.exe backend/start.py\"",
    "build": "react-scripts build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p e2e/tsconfig.json",
