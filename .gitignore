# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# Playwright
test-results/
playwright-report/

# Python
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
*.egg-info/
venv/
env/
.venv/
.coverage
htmlcov/
backend/staticfiles/
backend/media/
backend/db.sqlite3
.ruff_cache/

# production
/build

# IDE
.vscode/
.idea/
*.swp
*.swo

# Claude Code
.claude/

# misc
.DS_Store
Thumbs.db
desktop.ini
# Every env file is local-only except the committed templates (.env.example,
# .env.db.example). .env.docker holds real secrets (TMDB key, mail password) and
# .env.db the database password; .env.* also catches the copies people make
# while editing (.env.docker.bak, .env.local, .env.old, ...). The same patterns
# are in both .dockerignore files, so no copy ends up in an image either.
.env
.env.*
!.env.example
!.env.db.example
*.env.bak

# local setup scripts (may contain IPs or credentials)
enable-lan.ps1
start.ps1

# ad-hoc verification scratch scripts/screenshots (see CLAUDE.md)
# root-scoped only (leading /) — docs/screenshots/*.png (README assets) stay tracked
/verify_*.js
/verify_*.py
/typo_*.png
/*.png

npm-debug.log*
yarn-debug.log*
yarn-error.log*
